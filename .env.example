# Cloudflare Credentials Template
# Copy this file to .env and fill in your actual credentials securely.
# Do NOT commit .env to version control.

# Cloudflare API Token (Create one at: https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN_HERE"

# Cloudflare Account ID (Found in Cloudflare dashboard URL or Workers overview)
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID_HERE"
